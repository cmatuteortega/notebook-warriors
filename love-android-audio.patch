+		// does not run until the app is back on screen -- and neither does any
+		// love.visible or love.focus handler in Lua, which is why a game cannot fix
+		// this for itself. OpenAL mixes on a thread of its own and is blocked by
+		// none of it, so without this the music plays on to a locked screen or a
+		// pocket for as long as the app is away.
+		{
+			auto audio = Module::getInstance<audio::Audio>(Module::M_AUDIO);
+			if (audio && SDL_IsMainThread())
+			{
+				if (event->type == SDL_EVENT_DID_ENTER_BACKGROUND)
+					audio->pauseContext();
+				else
+					audio->resumeContext();
+			}
+		}
+#endif
