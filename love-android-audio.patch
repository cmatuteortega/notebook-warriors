+#ifdef LOVE_ANDROID
+		// Android's audio has to be handled here too, for a stronger version of the
+		// same reason. SDL blocks the thread the whole program runs on as soon as
+		// the activity pauses, and it blocks inside the very event pump that posts
+		// this event: Android_PumpEvents' timeout goes to "wait forever" on the
